NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=copy-the-publishable-key-from-supabase-start
# Server-only private JWK from untracked supabase/signing_keys.json.
# Keep the JSON on one line. Never prefix this variable with NEXT_PUBLIC_.
MACHINE_JWT_PRIVATE_JWK=copy-one-line-private-jwk-json-here
