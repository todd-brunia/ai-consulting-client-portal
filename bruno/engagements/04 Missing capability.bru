meta {
  name: Missing capability
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/engagements
  body: none
  auth: none
}

headers {
  Accept: application/vnd.api+json
  Authorization: Bearer {{process.env.PORTAL_NO_CAPABILITY_API_KEY}}
}

tests {
  test("returns the generic JSON:API authorization error", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getHeader("content-type")).to.equal("application/vnd.api+json");
    expect(res.getBody()).to.eql({
      errors: [{
        status: "403",
        code: "forbidden",
        title: "Access denied"
      }]
    });
  });
}
