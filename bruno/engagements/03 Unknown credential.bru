meta {
  name: Unknown credential
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/engagements
  body: none
  auth: none
}

headers {
  Accept: application/vnd.api+json
  Authorization: Bearer {{process.env.PORTAL_UNKNOWN_API_KEY}}
}

tests {
  test("does not disclose whether the credential exists", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getHeader("content-type")).to.equal("application/vnd.api+json");
    expect(res.getBody()).to.eql({
      errors: [{
        status: "401",
        code: "unauthorized",
        title: "Authentication required"
      }]
    });
  });
}
