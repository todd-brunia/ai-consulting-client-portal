meta {
  name: Revoke invitation
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/invitations/{{replacementInvitationId}}/revoke
  body: none
  auth: none
}

headers {
  Cookie: {{process.env.PORTAL_STAFF_COOKIE}}
}

tests {
  test("revokes the replacement invitation", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.data.attributes.status).to.equal("revoked");
  });
}
